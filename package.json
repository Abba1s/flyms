{
  "name": "flyms",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @flyms/web dev",
    "build": "pnpm --filter @flyms/web build",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:build": "python3 -I scripts/build_seed.py",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "supabase": "^2.6.8",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
