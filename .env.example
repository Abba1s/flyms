# Frontend (public by design — protected by RLS)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Cloudflare test key for local dev (always passes): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
# Map tiles (optional; defaults to OpenStreetMap standard tiles). Use a keyed provider in production.
VITE_MAP_TILES_LIGHT=
VITE_MAP_TILES_DARK=
VITE_MAP_TILES_ATTRIBUTION=

# Edge Functions only — set with `supabase secrets set`, never commit
# SUPABASE_SERVICE_ROLE_KEY=
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# SOP_MOCK=1   # local only, when ANTHROPIC_API_KEY is not set
# TURNSTILE_SECRET_KEY=
# SOP_DAILY_LIMIT_PER_IP=5
# SOP_GLOBAL_DAILY_CAP=500
# REWRITE_DAILY_LIMIT_PER_IP=20
# Cookie-less analytics (optional). Leave empty to disable.
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SRC=
